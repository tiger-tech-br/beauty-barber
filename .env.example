# Copie para .env apenas em ambiente local; nunca publique o arquivo real.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://beautybarber_app:troque_esta_senha@localhost:5432/beautybarber
WEB_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=beautybarber_session
# DESATIVADO até definir formalmente política comercial, teste e inadimplência.
SUBSCRIPTION_ENFORCEMENT=false

# Obrigatório para habilitar o agendamento público verificado por e-mail.
# Verifique seu domínio de envio no Resend; nunca coloque a chave no frontend.
RESEND_API_KEY=
RESEND_FROM=

# Usadas apenas pelo Docker Compose na VPS ou no teste local com Docker.
POSTGRES_USER=beautybarber_app
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=beautybarber
# Porta local da VPS, a ser verificada antes de instalar. Não abre acesso público.
BEAUTYBARBER_LOCAL_PORT=18080
SITE_ADDRESS=:80

